# Porta usada pelo backend NestJS no ambiente local.
PORT=3000

# Chave secreta para assinar tokens JWT.
# Em production, defina uma chave forte e mantenha em segredo.
JWT_SECRET=dev-secret-nao-use-em-producao

# Ambiente da aplicacao (development, staging, production).
NODE_ENV=development

# URL de conexão do PostgreSQL usado pelo backend.
# Ajuste os dados de usuário, senha e host conforme o seu ambiente.
DATABASE_URL=postgresql://root:rootpassword@localhost:5432/conectaunb?schema=public

# Chave secreta usada para assinar os tokens JWT (obrigatória).
JWT_SECRET=minha-chave-secreta-aqui

# Número de rounds do bcrypt para hash de senha (opcional, padrão 10).
# BCRYPT_SALT_ROUNDS=10

# Origens permitidas pelo CORS (opcional, padrão *).
# CORS_ORIGIN=http://localhost:3001
# FRONTEND_URL=http://localhost:3001

# Em development o Swagger ja eh habilitado automaticamente.
# Para habilitar fora de development, defina como true.
SWAGGER_ENABLED=false

# O backend nao possui autenticacao basica para o Swagger no momento.
# Quando SWAGGER_ENABLED=true, /api/docs e /api/docs-json ficam expostos.

# Cloudflare R2 / Object Storage
# Se R2_BUCKET_NAME estiver vazio, o backend usa armazenamento local (apps/back/uploads).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=

# Driver de armazenamento: "r2" (producao) ou "local" (desenvolvimento).
# Se vazio, auto-detecta: "r2" quando R2_BUCKET_NAME estiver definido, senao "local".
# STORAGE_DRIVER=local

# Tamanho maximo por upload em bytes (default 5MB).
# UPLOAD_MAX_FILE_SIZE_BYTES=5242880

# Quota de armazenamento por Perfil em bytes (default 50MB).
# Soma todos os arquivos cujo ownerId = Perfil.id.
# PERFIL_STORAGE_QUOTA_BYTES=52428800

# URL base do backend, usada para compor URLs publicas quando STORAGE_DRIVER=local.
# BACKEND_PUBLIC_BASE_URL=http://localhost:3000
