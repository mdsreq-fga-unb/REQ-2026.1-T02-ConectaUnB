generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Perfil {
  id                        Int @id @default(autoincrement())
  name                      String @db.Text
  email                     String @unique
  matricula                 Int? @unique
  senha                     String
  linkFoto                  String?
  curso                     Curso
  departamento              Departamento
  campus                    Campus
  cargo                     Cargo
  PreferenciaNotificacao    PreferenciaNotificacao?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  ultimaLeituraNotificacoes DateTime @default(now())

  Membro              Membro[]
  Seguindo            Seguindo[]
  Curtidas            Curtidas[]
  Inscricao           Inscricao[]
}

model Entidade {
  id               Int @id @default(autoincrement())
  nome             String @db.Text
  descricao        String? @db.Text 
  classificacao    ClassificacaoEntidade
  campus           Campus
  departamento     Departamento
  linkBanner       String?
  linkLogo         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  membros            Membro[]
  seguidores         Seguindo[]
  postagens          Postagem[]
  projetos           Projeto[]
  processosSeletivos ProcessoSeletivo[]
  notificacoes       Notificacao[]
}

model Membro {
  id              Int @id @default(autoincrement())
  idPerfil        Int
  idEntidade      Int
  classificacao   ClassificacaoMembro
  createdAt       DateTime @default(now())

  perfil          Perfil @relation(fields: [idPerfil], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entidade        Entidade @relation(fields: [idEntidade], references: [id], onDelete: Cascade, onUpdate: Cascade)

  gerenteProjetos     gerentesProjetos[]
  colaboradorProjetos colaboradoresProjetos[]
}

model Seguindo {
  idPerfil    Int
  idEntidade  Int
  createdAt   DateTime @default(now())

  perfil      Perfil @relation(fields: [idPerfil], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entidade    Entidade @relation(fields: [idEntidade], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([idPerfil, idEntidade])
}

model Postagem {
  id            Int @id @default(autoincrement())
  idEntidade    Int
  titulo        String @db.Text
  conteudo      String @db.Text
  linkFoto      String?
  createdAt     DateTime @default(now())

  entidade      Entidade @relation(fields: [idEntidade], references: [id], onDelete: Cascade, onUpdate: Cascade)

  curtidas       Curtidas[]
}

model Curtidas {
  idPostagem  Int
  idPerfil    Int
  createdAt   DateTime @default(now())

  perfil      Perfil @relation(fields: [idPerfil], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postagem    Postagem @relation(fields: [idPostagem], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([idPostagem, idPerfil])
}

model Projeto {
  id              Int @id @default(autoincrement())
  idEntidade      Int
  nome            String @db.Text
  descricao       String? @db.Text
  linkFoto        String?
  status          StatusProjeto
  gerentes         gerentesProjetos[]
  colaboradores   colaboradoresProjetos[]
  dataInicio      DateTime
  dataFim         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entidade        Entidade @relation(fields: [idEntidade], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model gerentesProjetos {
  idProjeto   Int
  idMembro    Int
  createdAt   DateTime @default(now())

  projeto     Projeto @relation(fields: [idProjeto], references: [id], onDelete: Cascade, onUpdate: Cascade)
  membro      Membro @relation(fields: [idMembro], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([idProjeto, idMembro])
}

model colaboradoresProjetos {
  idProjeto   Int
  idMembro    Int
  createdAt   DateTime @default(now())

  projeto     Projeto @relation(fields: [idProjeto], references: [id], onDelete: Cascade, onUpdate: Cascade)
  membro      Membro @relation(fields: [idMembro], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([idProjeto, idMembro])
}

model ProcessoSeletivo {
  id              Int @id @default(autoincrement())
  idEntidade      Int
  titulo          String @db.Text
  descricao       String? @db.Text
  classificacao   ClassificacaoInscricao
  linkFoto        String?
  linkIncricao    String?
  inicioInscricao DateTime
  fimInscricao    DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entidade        Entidade @relation(fields: [idEntidade], references: [id], onDelete: Cascade, onUpdate: Cascade)

  inscricoes      Inscricao[]
}

model Inscricao {
  idProcessoSeletivo  Int
  idPerfil            Int
  createdAt           DateTime @default(now())

  perfil              Perfil @relation(fields: [idPerfil], references: [id], onDelete: Cascade, onUpdate: Cascade)
  processoSeletivo    ProcessoSeletivo @relation(fields: [idProcessoSeletivo], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([idProcessoSeletivo, idPerfil])
}

model Notificacao {
  id              Int @id @default(autoincrement())
  idEntidade      Int
  tipo            TipoNotificacao
  mensagem        String @db.Text
  referenciaId    Int
  createdAt       DateTime @default(now())

  entidade        Entidade @relation(fields: [idEntidade], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model PreferenciaNotificacao {
  idPerfil              Int
  processoSeletivo      Boolean @default(true)
  atualizacaoProjeto    Boolean @default(true)
  atualizacaoPublicacao Boolean @default(true)

  perfil                Perfil @relation(fields: [idPerfil], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([idPerfil])
}

enum Cargo {
  DOCENTE
  DISCENTE
}

enum Campus {
CEILANDIA
GAMA
DARCY
PLANALTINA
}

enum ClassificacaoEntidade {
  EMPRESA_JUNIOR
  EQUIPE_COMPETICAO
  PROJETO_EXTENSAO
  ATLETICA
}

enum StatusProjeto {
  PLANEJAMENTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  PAUSADO
}

enum ClassificacaoMembro {
  GESTOR
  CO_GESTOR
  MEMBRO
}

enum ClassificacaoInscricao {
  ABERTA
