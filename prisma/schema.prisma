generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id           String   @id @default(uuid())
  key          String   @unique
  url          String
  originalName String
  mimeType     String
  size         Int
  entity       String?
  entityId     String?
  ownerId      String?
  createdAt    DateTime @default(now())

  @@map("files")
}